# Generated from the Omarchy color palette for this theme.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0B0C16"

# Main text color
theme[main_fg]="#ddf7ff"

# Title color for boxes
theme[title]="#7cf8f7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#82FB9C"

# Background color of selected item in processes box
theme[selected_bg]="#2d3450"

# Foreground color of selected item in processes box
theme[selected_fg]="#ddf7ff"

# Color of inactive/disabled text
theme[inactive_fg]="#2d3450"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#82FB9C"

# Cpu box outline color
theme[cpu_box]="#2d3450"

# Memory/disks box outline color
theme[mem_box]="#2d3450"

# Net up/down box outline color
theme[net_box]="#2d3450"

# Processes box outline color
theme[proc_box]="#2d3450"

# Box divider line and small boxes line color
theme[div_line]="#2d3450"

# Temperature graph colors
theme[temp_start]="#82FB9C"
theme[temp_mid]="#7cf8f7"
theme[temp_end]="#ddf7ff"

# CPU graph colors
theme[cpu_start]="#82FB9C"
theme[cpu_mid]="#7cf8f7"
theme[cpu_end]="#ddf7ff"

# Mem/Disk free meter
theme[free_start]="#82FB9C"
theme[free_mid]="#7cf8f7"
theme[free_end]="#ddf7ff"

# Mem/Disk cached meter
theme[cached_start]="#82FB9C"
theme[cached_mid]="#7cf8f7"
theme[cached_end]="#ddf7ff"

# Mem/Disk available meter
theme[available_start]="#82FB9C"
theme[available_mid]="#7cf8f7"
theme[available_end]="#ddf7ff"

# Mem/Disk used meter
theme[used_start]="#82FB9C"
theme[used_mid]="#7cf8f7"
theme[used_end]="#ddf7ff"

# Download graph colors
theme[download_start]="#82FB9C"
theme[download_mid]="#7cf8f7"
theme[download_end]="#ddf7ff"

# Upload graph colors
theme[upload_start]="#82FB9C"
theme[upload_mid]="#7cf8f7"
theme[upload_end]="#ddf7ff"
