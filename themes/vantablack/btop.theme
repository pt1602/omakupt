# Generated from the Omarchy color palette for this theme.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#ffffff"

# Title color for boxes
theme[title]="#b0b0b0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8d8d8d"

# Background color of selected item in processes box
theme[selected_bg]="#7a7a7a"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#7a7a7a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#8d8d8d"

# Cpu box outline color
theme[cpu_box]="#7a7a7a"

# Memory/disks box outline color
theme[mem_box]="#7a7a7a"

# Net up/down box outline color
theme[net_box]="#7a7a7a"

# Processes box outline color
theme[proc_box]="#7a7a7a"

# Box divider line and small boxes line color
theme[div_line]="#7a7a7a"

# Temperature graph colors
theme[temp_start]="#8d8d8d"
theme[temp_mid]="#b0b0b0"
theme[temp_end]="#ffffff"

# CPU graph colors
theme[cpu_start]="#8d8d8d"
theme[cpu_mid]="#b0b0b0"
theme[cpu_end]="#ffffff"

# Mem/Disk free meter
theme[free_start]="#8d8d8d"
theme[free_mid]="#b0b0b0"
theme[free_end]="#ffffff"

# Mem/Disk cached meter
theme[cached_start]="#8d8d8d"
theme[cached_mid]="#b0b0b0"
theme[cached_end]="#ffffff"

# Mem/Disk available meter
theme[available_start]="#8d8d8d"
theme[available_mid]="#b0b0b0"
theme[available_end]="#ffffff"

# Mem/Disk used meter
theme[used_start]="#8d8d8d"
theme[used_mid]="#b0b0b0"
theme[used_end]="#ffffff"

# Download graph colors
theme[download_start]="#8d8d8d"
theme[download_mid]="#b0b0b0"
theme[download_end]="#ffffff"

# Upload graph colors
theme[upload_start]="#8d8d8d"
theme[upload_mid]="#b0b0b0"
theme[upload_end]="#ffffff"
