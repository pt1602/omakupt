# Generated from the Omarchy color palette for this theme.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#fafafa"

# Main text color
theme[main_fg]="#212121"

# Title color for boxes
theme[title]="#0c67de"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#3264eb"

# Background color of selected item in processes box
theme[selected_bg]="#9e9e9e"

# Foreground color of selected item in processes box
theme[selected_fg]="#000000"

# Color of inactive/disabled text
theme[inactive_fg]="#9e9e9e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#3264eb"

# Cpu box outline color
theme[cpu_box]="#9e9e9e"

# Memory/disks box outline color
theme[mem_box]="#9e9e9e"

# Net up/down box outline color
theme[net_box]="#9e9e9e"

# Processes box outline color
theme[proc_box]="#9e9e9e"

# Box divider line and small boxes line color
theme[div_line]="#9e9e9e"

# Temperature graph colors
theme[temp_start]="#3264eb"
theme[temp_mid]="#0c67de"
theme[temp_end]="#000000"

# CPU graph colors
theme[cpu_start]="#3264eb"
theme[cpu_mid]="#0c67de"
theme[cpu_end]="#000000"

# Mem/Disk free meter
theme[free_start]="#3264eb"
theme[free_mid]="#0c67de"
theme[free_end]="#000000"

# Mem/Disk cached meter
theme[cached_start]="#3264eb"
theme[cached_mid]="#0c67de"
theme[cached_end]="#000000"

# Mem/Disk available meter
theme[available_start]="#3264eb"
theme[available_mid]="#0c67de"
theme[available_end]="#000000"

# Mem/Disk used meter
theme[used_start]="#3264eb"
theme[used_mid]="#0c67de"
theme[used_end]="#000000"

# Download graph colors
theme[download_start]="#3264eb"
theme[download_mid]="#0c67de"
theme[download_end]="#000000"

# Upload graph colors
theme[upload_start]="#3264eb"
theme[upload_mid]="#0c67de"
theme[upload_end]="#000000"
