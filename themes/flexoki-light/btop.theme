# Generated from the Omarchy color palette for this theme.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#FFFCF0"

# Main text color
theme[main_fg]="#100F0F"

# Title color for boxes
theme[title]="#3AA99F"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#205EA6"

# Background color of selected item in processes box
theme[selected_bg]="#B7B5AC"

# Foreground color of selected item in processes box
theme[selected_fg]="#100F0F"

# Color of inactive/disabled text
theme[inactive_fg]="#B7B5AC"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#205EA6"

# Cpu box outline color
theme[cpu_box]="#B7B5AC"

# Memory/disks box outline color
theme[mem_box]="#B7B5AC"

# Net up/down box outline color
theme[net_box]="#B7B5AC"

# Processes box outline color
theme[proc_box]="#B7B5AC"

# Box divider line and small boxes line color
theme[div_line]="#B7B5AC"

# Temperature graph colors
theme[temp_start]="#205EA6"
theme[temp_mid]="#3AA99F"
theme[temp_end]="#100F0F"

# CPU graph colors
theme[cpu_start]="#205EA6"
theme[cpu_mid]="#3AA99F"
theme[cpu_end]="#100F0F"

# Mem/Disk free meter
theme[free_start]="#205EA6"
theme[free_mid]="#3AA99F"
theme[free_end]="#100F0F"

# Mem/Disk cached meter
theme[cached_start]="#205EA6"
theme[cached_mid]="#3AA99F"
theme[cached_end]="#100F0F"

# Mem/Disk available meter
theme[available_start]="#205EA6"
theme[available_mid]="#3AA99F"
theme[available_end]="#100F0F"

# Mem/Disk used meter
theme[used_start]="#205EA6"
theme[used_mid]="#3AA99F"
theme[used_end]="#100F0F"

# Download graph colors
theme[download_start]="#205EA6"
theme[download_mid]="#3AA99F"
theme[download_end]="#100F0F"

# Upload graph colors
theme[upload_start]="#205EA6"
theme[upload_mid]="#3AA99F"
theme[upload_end]="#100F0F"
